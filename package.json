{
  "name": "dbtool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "db:migrate": "node scripts/migrate.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync",
    "preinstall": "node scripts/nacelle-install.js",
    "postinstall": "node scripts/nacelle-install.js --ensure",
    "nacelle:update": "node scripts/nacelle-install.js --update"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@types/pg": "^8.23.1",
    "codemirror": "^6.0.2",
    "exceljs": "^4.4.0",
    "nacelle-core": "file:nacelle/nacelle-core",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "svelte": "^5.34.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.4"
  },
  "nacelle": {
    "registry": "git+ssh://git@github.com/Wilmington-Health/nacelle-svelte.git",
    "packages": {
      "nacelle-core": {
        "path": "packages/core",
        "ref": "main"
      }
    }
  }
}
