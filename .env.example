# Single port for the whole app (UI + API). On a console-managed deploy the
# console owns this (injects PORT); this is for local dev.
PORT=9999
HOST=127.0.0.1

# LLM provider: ollama | openai
LLM_PROVIDER=ollama

# Ollama (OpenAI-compatible, local). Used when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_API_KEY=ollama

# dbtool "Ask" / datamaps. Model defaults to the first installed gemma; ctx cap
# protects VRAM; describe limit = how many tables (largest first) get LLM
# descriptions per datamap build.
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_MAX_CTX=32768
# DATAMAP_DESCRIBE_LIMIT=300

# OpenAI. Used when LLM_PROVIDER=openai.
# OPENAI_API_KEY=sk-...

# The environment comes from PORT: 8000-8999 = prod; anything else = dev
# (exposes /api/debug/* and full error detail).

# Root logger floor (DEBUG/INFO/WARNING/ERROR/CRITICAL).
LOG_LEVEL=INFO

# Unset locally = no console heartbeats (the /health route still works).
# CONSOLE_URL=http://localhost:7999

# Optional: capture full LLM input/output to its own SQLite db, browsable in
# /debug/logs. Truthy keyword writes logs/llm_io.sqlite3, or pass a path.
# LLM_IO_LOG=1
